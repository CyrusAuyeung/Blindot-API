BREVO_API_KEY=CHANGE_ME
FROM_EMAIL=noreply@example.com
FROM_NAME=Blindot API
REPLY_TO=support@example.com
SMTP_PORT=8025
SMTP_AUTH_USER=sub2api
SMTP_AUTH_PASS=CHANGE_ME
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_MAX_RECIPIENTS=1
SMTP_MAX_CLIENTS=20
SMTP_SOCKET_TIMEOUT_MS=60000
BREVO_TIMEOUT_MS=15000
# Optional overrides. Defaults derive from SMTP_HOSTNAME in the main .env.
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=
# Example: /etc/letsencrypt/live/smtp.example.com/privkey.pem
# Example: /etc/letsencrypt/live/smtp.example.com/fullchain.pem
